# ==============================================================================
# Netra Backend - Environment Configuration (.env)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=change-this-in-production-dev-secret-key-netra-ai-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
ADMIN_URL=admin/

# Database Configuration
# In development (SQLite):
DATABASE_URL=sqlite:///db.sqlite3
# In production (PostgreSQL):
# DATABASE_URL=postgresql://netra_user:netra_pass@localhost:5432/netra_db

# Redis & Channels Configuration
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Google Gemini Multimodal Vision & Audio Guidance
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-2.0-flash
VISION_BACKEND=auto  # Options: 'auto' (Gemini in cloud / fallback), 'gemini', 'yolo'

# Production Initial Admin & Demo User Auto-Provisioning
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@netra-ai.org
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# Internationalization
LANGUAGE_CODE=en

